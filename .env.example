PORT=3000
NODE_ENV=development

# Set these before first startup to use the same login on a fresh install.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-this-before-starting

# Use a long, unique random value. Required when NODE_ENV=production.
SESSION_SECRET=replace-with-a-long-random-secret

# Keep these paths on persistent storage in hosted deployments.
DB_PATH=data/app.db
TER_CACHE_PATH=ter-cache.json